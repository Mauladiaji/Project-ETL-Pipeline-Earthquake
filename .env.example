# Template for local configuration.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored and must never be committed.

# --- PostgreSQL (local instance from docker-compose.yml) ---
# Use localhost when connecting from the host machine (your venv).
# Use the service name "postgres" when connecting from inside another container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=bmkg
POSTGRES_USER=bmkg_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# --- Source data (BMKG Open Data, public, no API key required) ---
BMKG_BASE_URL=https://data.bmkg.go.id/DataMKG/TEWS

# --- Pipeline runtime ---
RAW_DATA_DIR=data/raw
LOG_LEVEL=INFO
